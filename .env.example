# Zestoxx environment. Copy the DB lines to .env and the token to .env.local.
# .env* is gitignored (except this file). Never commit real values.
#
#   .env        <- Prisma CLI reads this (migrate / generate). DB vars go here.
#   .env.local  <- Next.js app runtime. Secrets like the Upstox token go here.
#   Vercel      <- set all of them in Project Settings > Environment Variables.

# ---------------------------------------------------------------------------
# Database (Prisma + Postgres). Required.
# ---------------------------------------------------------------------------
# DATABASE_URL : pooled connection, used by the app at runtime.
# DIRECT_URL   : direct (non-pooled) connection, used by `prisma migrate`.
# No pooler? Set both to the same direct URL — fine for low traffic.
#
# Local dev: point these at a SEPARATE dev database / branch on the same host.
DATABASE_URL="postgresql://user:password@host:5432/zestoxx?schema=public&sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/zestoxx?schema=public&sslmode=require"

# ---------------------------------------------------------------------------
# Upstox — real NSE/BSE quotes + historical candles (app/api/market-data/route.ts).
# Long-lived, read-only "Analytics Token" used as a static Bearer header — no OAuth.
# Generate at https://account.upstox.com/developer/apps
# Without it, equities/indices stay on the seeded simulation (app still builds/runs).
# ---------------------------------------------------------------------------
UPSTOX_ANALYTICS_TOKEN=

# ---------------------------------------------------------------------------
# FII/DII daily ingest (Vercel Cron). Required in Production.
# ---------------------------------------------------------------------------
# CRON_SECRET : any long random string. Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/fiidii,
#               which refuses to run without it (503) or with a wrong one (401). Set it in Vercel > Environment Variables.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Mutual fund NAV storage (AMFI). OFF unless set to exactly "true".
# ---------------------------------------------------------------------------
# MF_INGEST_ENABLED : "true" makes the daily cron fetch AMFI's NAV file and store it. Leave it unset until AMFI's written permission
#                     to store and show its NAV data has been settled (see docs/mf/DATA-APPROACH.md). The backfill script
#                     (scripts/mf-backfill.ts) is separate and reads MF_DATABASE_URL, which you set in your own terminal only.
MF_INGEST_ENABLED=
