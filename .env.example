# Zestoxx environment — copy to .env and fill in. Never commit real keys (.env* is gitignored).

# ---------------------------------------------------------------------------
# Database (Prisma). Required — the portfolio persists here via /api/portfolio.
# ---------------------------------------------------------------------------
# Local dev (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
#
# Production (Postgres) — also switch `provider` to "postgresql" in
# prisma/schema.prisma, then run `npm run db:deploy`:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zestoxx?schema=public&sslmode=require"

# ---------------------------------------------------------------------------
# Upstox — real NSE/BSE quotes + historical candles (app/api/market-data/route.ts).
# This is a long-lived, read-only "Analytics Token" used as a static Bearer header —
# no OAuth login/callback. Generate one at https://account.upstox.com/developer/apps.
# Put the real value in .env.local (gitignored), or Vercel env for production.
# Without it, equities/indices just stay on the seeded simulation.
# ---------------------------------------------------------------------------
UPSTOX_ANALYTICS_TOKEN=
